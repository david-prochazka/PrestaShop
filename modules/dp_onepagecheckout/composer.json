{
    "name": "integritty/dp_onepagecheckout",
    "description": "Modern one-page checkout module for PrestaShop 9 — all checkout steps on a single page with AJAX updates.",
    "type": "prestashop-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Integritty",
            "email": "david.prochazka@integritty.cz"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "Integritty\\OnePageCheckout\\": "src/"
        },
        "classmap": [
            "dp_onepagecheckout.php"
        ],
        "exclude-from-classmap": []
    },
    "config": {
        "prepend-autoloader": false,
        "preferred-install": "dist"
    }
}
